--- evals/configs/baseline.toml
+++ evals/configs/haiku-advisor-opus.toml
@@ -1,18 +1,27 @@
-# The Baseline: the rules-only configuration every other configuration is compared
-# against. Repair is off, so a run makes no LLM calls and costs $0.
+# M5 advisor: Haiku 5.5 runs every attempt and may consult Opus 5.5 through the
+# advisor tool (advisor_20260301), at most 2 times per request, 4,000 tokens each.
+# The advice comes back encrypted (it can be replayed, not logged); its tokens bill at
+# Opus rates and are priced from the response's usage.iterations.
 schema_version = 1
-name = "baseline"
-description = "Rules only: the dependency map and the official codemods, no repair agent."
+name = "haiku-advisor-opus"
+description = "Rules, then the repair agent on Claude Haiku 5.5 (high effort) with Claude Opus 5.5 as its advisor, up to 3 attempts per failing file."
 
 [repair]
-enabled = false
+enabled = true
+attempt_models = ["claude-haiku-5-5", "claude-haiku-5-5", "claude-haiku-5-5"]
+effort = "high"
+prompt_version = "v1-advisor"
+retrieval = "keyword"
+max_attempts = 3
 
-# Caps are recorded on every scorecard even when nothing can be spent (ticket #12).
+[repair.advisor]
+model = "claude-opus-5-5"
+max_uses = 2
+max_tokens = 4000
+
 [cost]
 max_run_usd = 5.0
 max_month_usd = 20.0
 
-# Every rule step of the migration spec runs; list codemod or script step names in
-# `skip` to switch one off.
 [rules]
 skip = []
