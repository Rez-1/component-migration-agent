>\n52          ))}\n53        </List>\n54        <Button\n55          disabled={unread === 0}\n56          onClick={() => setNotices(notices.map((n) => ({ ...n, read: true })))}\n57        >\n58          Mark all as read\n59        </Button>\n60      </Paper>\n61    );\n62  }",
