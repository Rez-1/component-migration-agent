n61    return (\n62      <section className={classes.root} aria-labelledby=\"activity-title\">\n63        <Typography id=\"activity-title\" variant=\"h5\" component=\"h1\">\n64          Activity\n65        </Typography>\n66        <>\n67          <List aria-label=\"Activity feed\">\n68            {entries.map((entry) => (\n69              <ListItem key={entry.id} tabIndex={-1}>\n70                <ListItemAvatar>\n71                  <Avatar>{entry.initials}</Avatar>\n72                </ListItemAvatar>\n73                <ListItemText primary={entry.text} secondary={entry.who} />\n74              </ListItem>\n75            ))}\n76          </List>\n77        </>\n78        <form className={classes.form} onSubmit={post}>\n79          <TextField\n80            id=\"activity-draft\"\n81            label=\"Post an update\"\n82            variant=\"outlined\"\n83            size=\"small\"\n84            fullWidth\n85            value={draft}\n86            onChange={(e) => setDraft(e.target.value)}\n87          />\n88          <Button type=\"submit\" variant=\"contained\" color=\"primary\">\n89            Post\n90          </Button>\n91        </form>\n92      </section>\n93    );\n94  }",
